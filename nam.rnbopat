                    "rnbo_extra_attributes": {
                        "code": "@state namw = new buffer(\"namw\");                  // 1871 weights (loaded from wav)\n@state W    = new FixedFloat32Array(1871);         // fast weight cache\n@state cached: Int = 0;\n\n@state Ks  = new FixedIntArray([6,6,6,6,6,6,6,6,6,6,6,6,6,6,15,15,6,6,6,6,6,6,6]);\n@state Ds  = new FixedIntArray([1,3,7,17,41,101,239,1,3,7,17,41,101,239,1,13,1,3,7,17,41,101,239]);\n@state WBs = new FixedIntArray([3,75,147,219,291,363,435,507,579,651,723,795,867,939,1011,1164,1317,1389,1461,1533,1605,1677,1749]);\n\nconst NL = 23;\nconst HK = 16;\nconst RS = 2048;\nconst SLOPE = 0.01;\nconst HB = 1821;\n\n@state hist  = new FixedFloat32Array(NL, 3, RS);\n@state hhist = new FixedFloat32Array(3, HK);\n@state t: Int = 0;\r\n\r\n\r\n// reset cache\r\nif(in2 > 0) {\r\n    cached = 0\r\n    }\r\n    \r\n// copy cache\nif (cached == 0) {\n    for (let ci = 0; ci < 1871; ci++) { W[ci] = peek(namw, ci)[0]; }\n    cached = 1;\n}\n\nlet cin = in1;\nlet li0 = W[0] * cin;\nlet li1 = W[1] * cin;\nlet li2 = W[2] * cin;\nlet hs0 = 0.0; let hs1 = 0.0; let hs2 = 0.0;\nlet wp: Int = t % RS;\n\nfor (let l = 0; l < NL; l++) {\n    let k  = Ks[l];\n    let d  = Ds[l];\n    let wb = WBs[l];\n\n    hist[l][0][wp] = li0;\n    hist[l][1][wp] = li1;\n    hist[l][2][wp] = li2;\n\n    let cb = wb + 9 * k;\n    let z0 = W[cb + 0];\n    let z1 = W[cb + 1];\n    let z2 = W[cb + 2];\n    for (let kk = 0; kk < k; kk++) {\n        let off = (k - 1 - kk) * d;\n        let idx: Int = (t - off + RS) % RS;\n        let s0 = hist[l][0][idx];\n        let s1 = hist[l][1][idx];\n        let s2 = hist[l][2][idx];\n        z0 = z0 + W[wb + (0*3+0)*k + kk]*s0 + W[wb + (0*3+1)*k + kk]*s1 + W[wb + (0*3+2)*k + kk]*s2;\n        z1 = z1 + W[wb + (1*3+0)*k + kk]*s0 + W[wb + (1*3+1)*k + kk]*s1 + W[wb + (1*3+2)*k + kk]*s2;\n        z2 = z2 + W[wb + (2*3+0)*k + kk]*s0 + W[wb + (2*3+1)*k + kk]*s1 + W[wb + (2*3+2)*k + kk]*s2;\n    }\n\n    let mb = wb + 9 * k + 3;\n    z0 = z0 + W[mb + 0] * cin;\n    z1 = z1 + W[mb + 1] * cin;\n    z2 = z2 + W[mb + 2] * cin;\n\n    let a0 = max(z0, 0) + SLOPE * min(z0, 0);\n    let a1 = max(z1, 0) + SLOPE * min(z1, 0);\n    let a2 = max(z2, 0) + SLOPE * min(z2, 0);\n\n    hs0 = hs0 + a0; hs1 = hs1 + a1; hs2 = hs2 + a2;\n\n    let lwb = wb + 9 * k + 6;\n    let lbb = wb + 9 * k + 15;\n    li0 = li0 + W[lbb+0] + W[lwb+0]*a0 + W[lwb+1]*a1 + W[lwb+2]*a2;\n    li1 = li1 + W[lbb+1] + W[lwb+3]*a0 + W[lwb+4]*a1 + W[lwb+5]*a2;\n    li2 = li2 + W[lbb+2] + W[lwb+6]*a0 + W[lwb+7]*a1 + W[lwb+8]*a2;\n}\n\nlet hwp: Int = t % HK;\nhhist[0][hwp] = hs0;\nhhist[1][hwp] = hs1;\nhhist[2][hwp] = hs2;\n\nlet y = W[HB + 48];\nfor (let kk = 0; kk < HK; kk++) {\n    let off = HK - 1 - kk;\n    let idx: Int = (t - off + HK) % HK;\n    let s0 = hhist[0][idx];\n    let s1 = hhist[1][idx];\n    let s2 = hhist[2][idx];\n    y = y + W[HB + 0*HK + kk]*s0 + W[HB + 1*HK + kk]*s1 + W[HB + 2*HK + kk]*s2;\n}\nout1 = y * W[HB + 49];\n\nt = (t + 1) % RS;\n",
